{
  "manifest_version": 3,
  "name": "Postglyph",
  "version": "0.1.4",
  "description": "Classifies LinkedIn feed posts with TypeSafe Jev and adds a confidence badge.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:43187/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Postglyph" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
